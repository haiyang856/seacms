# SeaCMS 安全加固
# 阻止 Web 访问敏感目录与文件

# 禁止访问 data 目录(含数据库配置、缓存、备份)
RewriteRule ^data/ - [F,L]

# 禁止访问 install 目录(安装完成后应删除)
RewriteRule ^install/ - [F,L]

<IfModule mod_authz_core.c>
    # Apache 2.4+: 禁止直接访问 data 目录内文件
    <FilesMatch "^(common\.inc\.php|config\.cache\.inc\.php|.*\.lock|.*\.txt|.*\.bak|.*\.sql)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(common\.inc\.php|config\.cache\.inc\.php|.*\.lock|.*\.txt|.*\.bak|.*\.sql)$">
        Order Deny,Allow
        Deny from all
    </FilesMatch>
</IfModule>
